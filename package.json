{
  "name": "csat-literacy-trainer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:watch": "vitest",
    "inspect:data": "python3 scripts/inspect-data.py",
    "d0": "node packages/pipeline/dist/cli/d0-spike.js",
    "agreement": "node packages/pipeline/dist/cli/agreement.js",
    "gold1": "node packages/pipeline/dist/cli/gold-one.js",
    "sim": "node packages/pipeline/dist/cli/sim.js",
    "qexp": "node packages/pipeline/dist/cli/query-experiment.js",
    "qgen": "node packages/pipeline/dist/cli/query-gen-experiment.js",
    "qgen:general": "node packages/pipeline/dist/cli/query-gen-generalize.js",
    "qgen:one": "node packages/pipeline/dist/cli/query-gen-one.js",
    "assess": "node packages/pipeline/dist/cli/assess.js",
    "adhoc": "node packages/pipeline/dist/cli/adhoc.js",
    "evalcase": "node packages/pipeline/dist/cli/eval-case-run.js",
    "ccfill": "node packages/pipeline/dist/cli/contradiction-backfill.js",
    "app:server": "node packages/app/dist/server/index.js",
    "repeat": "node packages/pipeline/dist/cli/repeat.js",
    "app:client": "vite --config packages/app/vite.config.ts",
    "typecheck:client": "tsc -p packages/app/tsconfig.client.json",
    "effort": "node packages/pipeline/dist/cli/effort-sweep.js",
    "content:import": "node packages/pipeline/dist/cli/content-import.js",
    "content:verify": "node packages/pipeline/dist/cli/semantic-migrate.js",
    "content:qualify": "node packages/pipeline/dist/cli/content-qualify.js",
    "content:generate-candidate": "node packages/pipeline/dist/cli/content-generate-candidate.js",
    "content:candidate-regression": "node packages/pipeline/dist/cli/content-candidate-regression.js",
    "content:title": "node packages/pipeline/dist/cli/content-promote-title.js",
    "title": "node packages/pipeline/dist/cli/title-probe.js",
    "title:gen": "node packages/pipeline/dist/cli/title-gen-run.js",
    "propfill": "node packages/pipeline/dist/cli/proposition-coverage.js",
    "qaudit": "node packages/pipeline/dist/cli/dedicated-query-audit.js",
    "experiment:dialogue": "npm run build --silent && node packages/pipeline/dist/cli/dialogue-experiment.js",
    "experiment:paragraph-analysis": "npm run build --silent && node packages/pipeline/dist/cli/paragraph-analysis-experiment.js",
    "experiment:central-axes": "npm run build --silent && node packages/pipeline/dist/cli/central-axes-batch.js",
    "experiment:axis-architecture": "npm run build --silent && node packages/pipeline/dist/cli/axis-architecture-experiment.js",
    "experiment:live-axis-replay": "npm run build --silent && node packages/pipeline/dist/cli/live-participant-axis-replay.js",
    "problem-path:probe": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-path-probe.js",
    "problem-path:four-route-probe": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-evaluator-four-route-probe.js",
    "problem-path:four-route-correct-probe": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-evaluator-four-route-correct-probe.js",
    "problem-path:selected-option-slice-ab": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-evaluator-selected-option-slice-ab.js",
    "problem-path:selected-option-risk-probes": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-evaluator-selected-option-risk-probes.js",
    "problem-path:model-quality-comparison": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-evaluator-model-quality-comparison.js",
    "problem-path:basic-probe-model-comparison": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-evaluator-basic-probe-model-comparison.js",
    "problem-path:boundary-target-probes": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-evaluator-boundary-target-probes.js",
    "problem-path:support-route-boundary-probes": "npm run build --silent && BOUNDARY_PROBE_SUITE=support-route node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-evaluator-boundary-target-probes.js",
    "problem-path:support-route-boundary-probes-terra": "npm run build --silent && BOUNDARY_PROBE_SUITE=support-route BOUNDARY_PROBE_MODEL=gpt-5.6-terra node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-evaluator-boundary-target-probes.js",
    "problem-path:vertical": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-path-vertical-slice.js",
    "problem-quality:report": "npm run build --silent && node packages/pipeline/dist/cli/problem-quality-report.js",
    "problem-fixtures:expand": "npm run build --silent && node packages/pipeline/dist/cli/generate-expanded-problem-fixtures.js",
    "problem-pilot:headless": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/headless-problem-pilot.js",
    "problem-inference:regression": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-inference-directionality-regression.js",
    "problem-gold:extrapolate": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-gold-extrapolation-generate.js",
    "problem-gold:extrapolation-audit": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-gold-extrapolation-audit.js",
    "problem-gold:extrapolation-repair": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-gold-extrapolation-repair.js",
    "problem-gold:student-cases": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-gold-extrapolation-student-cases.js",
    "problem-gold:extrapolation-evaluate": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-gold-extrapolation-evaluate.js",
    "problem-gold:explanation-cycle": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/problem-gold-explanation-cycle.js",
    "problem-gold:solution-profile": "npm run build --silent && node packages/pipeline/dist/cli/export-problem-solution-profiles.js",
    "dialogue-gold:mrna": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/generate-mrna-dialogue-gold.js",
    "dialogue-gold:generate": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/generate-mrna-dialogue-gold.js",
    "dialogue-gold:prospective-prepare": "npm run build --silent && node packages/pipeline/dist/cli/prepare-prospective-paragraph-gold.js",
    "dialogue-gold:prospective-run": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/run-prospective-paragraph-gold.js",
    "dialogue-gold:canary-review": "npm run build --silent && node packages/pipeline/dist/cli/build-prospective-paragraph-canary-review.js",
    "dialogue-gold:canary-collaborative-repair": "npm run build --silent && node packages/pipeline/dist/cli/apply-canary-collaborative-repair.js",
    "dialogue-gold:canary-approve": "npm run build --silent && node packages/pipeline/dist/cli/record-canary-paragraph-approval.js",
    "dialogue-gold:batch-002-collaborative-repair": "npm run build --silent && node packages/pipeline/dist/cli/apply-batch-002-collaborative-repair.js",
    "dialogue-gold:batch-002-approve": "npm run build --silent && node packages/pipeline/dist/cli/record-batch-002-paragraph-approval.js",
    "dialogue-gold:batch-003-collaborative-repair": "npm run build --silent && node packages/pipeline/dist/cli/apply-batch-003-collaborative-repair.js",
    "dialogue-gold:batch-003-approve": "npm run build --silent && node packages/pipeline/dist/cli/record-batch-003-paragraph-approval.js",
    "dialogue-gold:batch-004-report": "npm run build --silent && node packages/pipeline/dist/cli/build-batch-004-generalization-report.js",
    "dialogue-gold:batch-004-collaborative-repair-approve": "npm run build --silent && node packages/pipeline/dist/cli/apply-batch-004-collaborative-repair-and-approve.js",
    "dialogue-gold:batch-004-split-audit": "npm run build --silent && node --env-file-if-exists=.env packages/pipeline/dist/cli/run-batch-004-split-audit-experiment.js",
    "dialogue:ui": "npm run build --silent && node --env-file-if-exists=.env scripts/run-dialogue-ui.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
