{
  "name": "csat-literacy-trainer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect:data": "python3 scripts/inspect-data.py",
    "d0": "node packages/pipeline/dist/cli/d0-spike.js",
    "agreement": "node packages/pipeline/dist/cli/agreement.js",
    "sim": "node packages/pipeline/dist/cli/sim.js",
    "qexp": "node packages/pipeline/dist/cli/query-experiment.js",
    "qgen": "node packages/pipeline/dist/cli/query-gen-experiment.js",
    "qgen:general": "node packages/pipeline/dist/cli/query-gen-generalize.js",
    "assess": "node packages/pipeline/dist/cli/assess.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
