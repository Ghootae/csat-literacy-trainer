      "documentId": "ITEM-STEM",
      "mediaId": null,
      "rawText": "<보기>는 윗글을 이해하기 위한 학습 자료의 일부이다.",
      "documentStart": 0,
      "documentEnd": 30,
      "offsetBasis": "DOCUMENT_UTF16",
