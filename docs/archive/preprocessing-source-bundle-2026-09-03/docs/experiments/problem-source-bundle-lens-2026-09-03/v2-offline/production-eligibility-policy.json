    },
    {
      "auditState": "WARNING",
      "artifactFrozenAllowed": true,
      "productionEligible": "ONLY_IF_DOWNSTREAM_IMPACT_NONE"
    },
    {
      "auditState": "REPAIR_REQUIRED",
      "artifactFrozenAllowed": true,
      "productionEligible": false
    },
    {
      "auditState": "BLOCKING",
      "artifactFrozenAllowed": true,
      "productionEligible": false
    },
    {
      "auditState": "UNRESOLVED",
      "artifactFrozenAllowed": true,
      "productionEligible": "ONLY_AFTER_ALL_EXCLUSION_CHECKS_AND_HUMAN_APPROVAL"
    }
  ],
  "warningMayNotCover": [
    "DIRECTION",
    "COEFFICIENT",
    "EXPONENT",
    "NEGATION",
    "MODALITY",
    "REQUIRED_CONDITION",
    "CAUSE_EFFECT",
