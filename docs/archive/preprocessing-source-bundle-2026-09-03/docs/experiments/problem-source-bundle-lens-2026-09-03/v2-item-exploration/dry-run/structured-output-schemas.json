{
  "SourceBundleV2": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "bundleVersion": {
        "type": "string",
        "const": "problem-source-bundle-v2"
      },
      "scope": {
        "type": "string",
        "enum": [
          "PASSAGE",
          "ITEM"
        ]
      },
      "sourcePacketHash": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "sourceUnitRegistryHash": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "offsetFieldsProducedByModel": {
        "type": "boolean",
        "const": false
      },
      "itemDirectives": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sourceUnitId": {
              "type": "string",
              "pattern": "^I[0-9]+-S[1-9][0-9]*$"
            },
            "unitRole": {
              "type": "string",
              "const": "ITEM_DIRECTIVE"
            },
            "claimExtractionPolicy": {
              "type": "string",
              "const": "EXCLUDE"
            },
            "questionPolarity": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "SELECT_CORRECT",
                    "SELECT_INCORRECT",
                    "UNRESOLVED"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "sourceUnitId",
            "unitRole",
            "claimExtractionPolicy",
            "questionPolarity"
          ],
          "additionalProperties": false
        }
      },
      "claims": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "claimId": {
              "type": "string",
              "pattern": "^(?:P[1-9][0-9]*-S[1-9][0-9]*|I[0-9]+-S[1-9][0-9]*|FIG[1-9][0-9]*)-C[1-9][0-9]*$"
            },
            "sourceUnitId": {
              "type": "string",
              "minLength": 1
            },
            "normalizedClaim": {
              "type": "string",
              "minLength": 1
            },
            "polarity": {
              "type": "string",
              "enum": [
                "POSITIVE",
                "NEGATIVE"
              ]
            },
            "modality": {
              "type": "string",
              "enum": [
                "ASSERTED",
                "CONDITIONAL",
                "POSSIBLE",
                "TYPICAL"
              ]
            },
            "qualifiers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "evidenceFragments": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "claimId",
            "sourceUnitId",
            "normalizedClaim",
            "polarity",
            "modality",
            "qualifiers",
            "evidenceFragments"
          ],
          "additionalProperties": false
        }
      },
      "entities": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "entityId": {
              "type": "string",
              "pattern": "^E_[A-Z0-9_]+$"
            },
            "canonicalLabel": {
              "type": "string",
              "minLength": 1
            },
            "surfaceForms": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "definitionSourceUnitId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "definitionFragment": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "mergeBasis": {
              "type": "string",
              "enum": [
                "EXPLICIT_DEFINITION",
                "EXPLICIT_IDENTITY",
                "AUDITED_DEFINES",
                "AUDITED_SAME_AS",
                "HUMAN_APPROVAL"
              ]
            },
            "status": {
              "type": "string",
              "const": "EVIDENCE_GROUNDED_CANDIDATE"
            }
          },
          "required": [
            "entityId",
            "canonicalLabel",
            "surfaceForms",
            "definitionSourceUnitId",
            "definitionFragment",
            "mergeBasis",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "quantities": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "quantityId": {
              "type": "string",
              "pattern": "^Q_[A-Z0-9_]+$"
            },
            "quantityKind": {
              "type": "string",
              "enum": [
                "DISTANCE",
                "LENGTH",
                "ANGLE",
                "AREA",
                "COUNT",
                "VALUE",
                "OTHER"
              ]
            },
            "subjectEntityId": {
              "type": "string",
              "pattern": "^E_[A-Z0-9_]+$"
            },
            "referenceEntityId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^E_[A-Z0-9_]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "qualifiers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "quantityId",
            "quantityKind",
            "subjectEntityId",
            "referenceEntityId",
            "qualifiers"
          ],
          "additionalProperties": false
        }
      },
      "relations": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "relationId": {
                  "type": "string",
                  "pattern": "^R[1-9][0-9]*$"
                },
                "sourceUnitId": {
                  "type": "string",
                  "minLength": 1
                },
                "relationFamily": {
                  "type": "string",
                  "const": "RATIO"
                },
                "claimIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "leftQuantityId": {
                  "type": "string",
                  "pattern": "^Q_[A-Z0-9_]+$"
                },
                "operator": {
                  "type": "string",
                  "const": "="
                },
                "coefficient": {
                  "type": "number"
                },
                "rightQuantityId": {
                  "type": "string",
                  "pattern": "^Q_[A-Z0-9_]+$"
                },
                "interpretationRule": {
                  "type": "string",
                  "const": "LEFT_EQUALS_COEFFICIENT_TIMES_RIGHT"
                }
              },
              "required": [
                "relationId",
                "sourceUnitId",
                "relationFamily",
                "claimIds",
                "leftQuantityId",
                "operator",
                "coefficient",
                "rightQuantityId",
                "interpretationRule"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "relationId": {
                  "type": "string",
                  "pattern": "^R[1-9][0-9]*$"
                },
                "sourceUnitId": {
                  "type": "string",
                  "minLength": 1
                },
                "relationFamily": {
                  "type": "string",
                  "const": "PROPORTIONALITY"
                },
                "claimIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "independentQuantityId": {
                  "type": "string",
                  "pattern": "^Q_[A-Z0-9_]+$"
                },
                "dependentQuantityId": {
                  "type": "string",
                  "pattern": "^Q_[A-Z0-9_]+$"
                },
                "exponent": {
                  "type": "number"
                },
                "polarity": {
                  "type": "string",
                  "enum": [
                    "POSITIVE",
                    "NEGATIVE"
                  ]
                }
              },
              "required": [
                "relationId",
                "sourceUnitId",
                "relationFamily",
                "claimIds",
                "independentQuantityId",
                "dependentQuantityId",
                "exponent",
                "polarity"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "relationId": {
                  "type": "string",
                  "pattern": "^R[1-9][0-9]*$"
                },
                "sourceUnitId": {
                  "type": "string",
                  "minLength": 1
                },
                "relationFamily": {
                  "type": "string",
                  "enum": [
                    "DEFINES",
                    "SAME_AS",
                    "ATTRIBUTE",
                    "COMPARISON",
                    "CAUSAL",
                    "LOCATION",
                    "TOPOLOGY"
                  ]
                },
                "fromClaimIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "toClaimIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "conditionClaimIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "fromEntityIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "toEntityIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "operator": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "=",
                        "<",
                        "<=",
                        ">",
                        ">="
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "relationId",
                "sourceUnitId",
                "relationFamily",
                "fromClaimIds",
                "toClaimIds",
                "conditionClaimIds",
                "fromEntityIds",
                "toEntityIds",
                "operator"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "visualCandidates": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "candidateId": {
              "type": "string",
              "pattern": "^FIG[1-9][0-9]*-V[1-9][0-9]*$"
            },
            "parentFigureUnitId": {
              "type": "string",
              "pattern": "^FIG[1-9][0-9]*$"
            },
            "candidateType": {
              "type": "string",
              "enum": [
                "OBJECT",
                "LABEL",
                "REGION",
                "RELATION"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "region": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                {
                  "type": "null"
                }
              ]
            },
            "precision": {
              "type": "string",
              "enum": [
                "EXACT",
                "ORDINAL",
                "TOPOLOGICAL",
                "ILLUSTRATIVE"
              ]
            },
            "evidenceDescription": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "const": "CANDIDATE"
            }
          },
          "required": [
            "candidateId",
            "parentFigureUnitId",
            "candidateType",
            "label",
            "region",
            "precision",
            "evidenceDescription",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "mediaAssessment": {
        "type": "object",
        "properties": {
          "hasMedia": {
            "type": "boolean"
          },
          "visualRelevant": {
            "type": "boolean"
          },
          "visualRequiredForSourceUnderstanding": {
            "type": "boolean"
          },
          "visualRequiredForSolving": {
            "type": "string",
            "const": "UNASSESSED"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "hasMedia",
          "visualRelevant",
          "visualRequiredForSourceUnderstanding",
          "visualRequiredForSolving",
          "reason"
        ],
        "additionalProperties": false
      },
      "unresolved": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sourceUnitId": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "disposition": {
              "type": "string",
              "enum": [
                "HUMAN_REVIEW",
                "DO_NOT_ASSERT"
              ]
            }
          },
          "required": [
            "sourceUnitId",
            "description",
            "disposition"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "bundleVersion",
      "scope",
      "sourcePacketHash",
      "sourceUnitRegistryHash",
      "offsetFieldsProducedByModel",
      "itemDirectives",
      "claims",
      "entities",
      "quantities",
      "relations",
      "visualCandidates",
      "mediaAssessment",
      "unresolved"
    ],
    "additionalProperties": false
  },
  "SourceAuditV2": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "auditVersion": {
        "type": "string",
        "const": "problem-source-audit-v2"
      },
      "auditId": {
        "type": "string",
        "minLength": 1
      },
      "model": {
        "type": "string",
        "minLength": 1
      },
      "effort": {
        "type": "string",
        "enum": [
          "medium",
          "high"
        ]
      },
      "independentOfOtherAudit": {
        "type": "boolean",
        "const": true
      },
      "expectedSourceUnitIds": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "unitAudits": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sourceUnitId": {
              "type": "string",
              "minLength": 1
            },
            "candidateClaimIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "claimsReviewed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "candidateVisualIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "visualCandidatesReviewed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "omittedMeaningDetected": {
              "type": "boolean"
            },
            "unsupportedMeaningDetected": {
              "type": "boolean"
            },
            "omittedVisualMeaningDetected": {
              "type": "boolean"
            },
            "unsupportedVisualMeaningDetected": {
              "type": "boolean"
            },
            "decision": {
              "type": "string",
              "enum": [
                "PASS",
                "WARNING",
                "REPAIR_REQUIRED",
                "BLOCKING",
                "UNRESOLVED"
              ]
            },
            "downstreamImpact": {
              "type": "string",
              "enum": [
                "NONE",
                "POSSIBLE",
                "CONFIRMED"
              ]
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "issueCode": {
                    "type": "string",
                    "minLength": 1
                  },
                  "issueClass": {
                    "type": "string",
                    "enum": [
                      "NON_SEMANTIC_EXPRESSION",
                      "CLAIM_GRANULARITY",
                      "CANONICAL_LABEL",
                      "UNUSED_AUXILIARY",
                      "DIRECTION",
                      "COEFFICIENT",
                      "EXPONENT",
                      "NEGATION",
                      "MODALITY",
                      "REQUIRED_CONDITION",
                      "CAUSE_EFFECT",
                      "DEFINITION_TARGET",
                      "ENTITY_IDENTITY",
                      "SOURCE_LINEAGE",
                      "OMITTED_MEANING",
                      "UNSUPPORTED_MEANING",
                      "OTHER"
                    ]
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "affectedClaimIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "affectedVisualCandidateIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "issueCode",
                  "issueClass",
                  "description",
                  "affectedClaimIds",
                  "affectedVisualCandidateIds"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "sourceUnitId",
            "candidateClaimIds",
            "claimsReviewed",
            "candidateVisualIds",
            "visualCandidatesReviewed",
            "omittedMeaningDetected",
            "unsupportedMeaningDetected",
            "omittedVisualMeaningDetected",
            "unsupportedVisualMeaningDetected",
            "decision",
            "downstreamImpact",
            "issues"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "auditVersion",
      "auditId",
      "model",
      "effort",
      "independentOfOtherAudit",
      "expectedSourceUnitIds",
      "unitAudits"
    ],
    "additionalProperties": false
  }
}
