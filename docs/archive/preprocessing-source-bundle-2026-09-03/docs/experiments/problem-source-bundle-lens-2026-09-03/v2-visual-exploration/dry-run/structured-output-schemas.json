{
  "LensVisualObservation": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "observationVersion": {
        "type": "string",
        "const": "lens-visual-observation-v1"
      },
      "observationId": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]*$"
      },
      "mode": {
        "type": "string",
        "enum": [
          "VISUAL_ONLY",
          "TEXT_GROUNDED"
        ]
      },
      "mediaId": {
        "type": "string",
        "minLength": 1
      },
      "mediaHash": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "textContextHash": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "imageWasViewedAsWhole": {
        "type": "boolean",
        "const": true
      },
      "croppedImageUsed": {
        "type": "boolean",
        "const": false
      },
      "labels": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "candidateId": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_-]*$"
            },
            "labelText": {
              "type": "string",
              "minLength": 1
            },
            "linkedObjectId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_-]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidenceDescription": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "type": "string",
              "const": "VISUAL_OBSERVATION"
            },
            "status": {
              "type": "string",
              "const": "CANDIDATE"
            }
          },
          "required": [
            "candidateId",
            "labelText",
            "linkedObjectId",
            "evidenceDescription",
            "provenance",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "objects": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "candidateId": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_-]*$"
            },
            "linkedLabelTexts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "objectType": {
              "type": "string",
              "enum": [
                "POINT_MARK",
                "LINE_SEGMENT_MARK",
                "CIRCULAR_MARK",
                "AXIS_LINE",
                "RAY_LINE",
                "LENS",
                "PLANE_REGION",
                "TEXT_LABEL",
                "OTHER",
                "UNRESOLVED"
              ]
            },
            "appearanceDescription": {
              "type": "string",
              "minLength": 1
            },
            "authority": {
              "type": "string",
              "enum": [
                "EXACT_PIXEL_TOPOLOGY",
                "ILLUSTRATIVE",
                "UNRESOLVED"
              ]
            },
            "provenance": {
              "type": "string",
              "const": "VISUAL_OBSERVATION"
            },
            "status": {
              "type": "string",
              "const": "CANDIDATE"
            }
          },
          "required": [
            "candidateId",
            "linkedLabelTexts",
            "objectType",
            "appearanceDescription",
            "authority",
            "provenance",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "visualRelations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "candidateId": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_-]*$"
            },
            "relationType": {
              "type": "string",
              "enum": [
                "ON_DRAWN_LINE",
                "SAME_DRAWN_LINE",
                "NOT_ON_SAME_DRAWN_LINE",
                "ARROW_POINTS_TO",
                "INTERSECTS",
                "CONTAINS",
                "OVERLAPS",
                "VISUALLY_FARTHER_FROM",
                "EXACT_DISTANCE_RATIO",
                "PERPENDICULAR_3D",
                "PLANE_ASSIGNMENT",
                "OTHER",
                "UNRESOLVED"
              ]
            },
            "subjectObjectIds": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]*$"
              }
            },
            "objectObjectIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]*$"
              }
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "authority": {
              "type": "string",
              "enum": [
                "EXACT_PIXEL_TOPOLOGY",
                "ILLUSTRATIVE",
                "UNRESOLVED"
              ]
            },
            "scaleDependent": {
              "type": "boolean"
            },
            "provenance": {
              "type": "string",
              "const": "VISUAL_OBSERVATION"
            },
            "status": {
              "type": "string",
              "const": "CANDIDATE"
            }
          },
          "required": [
            "candidateId",
            "relationType",
            "subjectObjectIds",
            "objectObjectIds",
            "description",
            "authority",
            "scaleDependent",
            "provenance",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "crossModalInterpretations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "interpretationId": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_-]*$"
            },
            "visualCandidateIds": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]*$"
              }
            },
            "sourceTextClaimIds": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]*$"
              }
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "type": "string",
              "const": "CROSS_MODAL_INTERPRETATION"
            },
            "status": {
              "type": "string",
              "const": "CANDIDATE"
            }
          },
          "required": [
            "interpretationId",
            "visualCandidateIds",
            "sourceTextClaimIds",
            "statement",
            "provenance",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "unresolved": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "unresolvedId": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_-]*$"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "const": "UNRESOLVED"
            }
          },
          "required": [
            "unresolvedId",
            "description",
            "status"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "observationVersion",
      "observationId",
      "mode",
      "mediaId",
      "mediaHash",
      "textContextHash",
      "imageWasViewedAsWhole",
      "croppedImageUsed",
      "labels",
      "objects",
      "visualRelations",
      "crossModalInterpretations",
      "unresolved"
    ],
    "additionalProperties": false
  },
  "LensVisualAudit": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "auditVersion": {
        "type": "string",
        "const": "lens-visual-audit-v1"
      },
      "auditId": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]*$"
      },
      "model": {
        "type": "string",
        "const": "gpt-5.6-terra"
      },
      "effort": {
        "type": "string",
        "enum": [
          "medium",
          "high"
        ]
      },
      "independentOfOtherAudit": {
        "type": "boolean",
        "const": true
      },
      "mediaHash": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "candidateAudits": {
        "minItems": 4,
        "maxItems": 4,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "candidateLabel": {
              "type": "string",
              "enum": [
                "CANDIDATE_A",
                "CANDIDATE_B",
                "CANDIDATE_C",
                "CANDIDATE_D"
              ]
            },
            "declaredMode": {
              "type": "string",
              "enum": [
                "VISUAL_ONLY",
                "TEXT_GROUNDED"
              ]
            },
            "expectedLabelCandidateIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]*$"
              }
            },
            "labelCandidateIdsReviewed": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]*$"
              }
            },
            "expectedObjectCandidateIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]*$"
              }
            },
            "objectCandidateIdsReviewed": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]*$"
              }
            },
            "expectedRelationCandidateIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]*$"
              }
            },
            "relationCandidateIdsReviewed": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]*$"
              }
            },
            "expectedInterpretationIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]*$"
              }
            },
            "interpretationIdsReviewed": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]*$"
              }
            },
            "missingCriticalVisualMeaning": {
              "type": "boolean"
            },
            "unsupportedVisualMeaningDetected": {
              "type": "boolean"
            },
            "textAsVisualLeakageDetected": {
              "type": "boolean"
            },
            "scaleOverclaimDetected": {
              "type": "boolean"
            },
            "decision": {
              "type": "string",
              "enum": [
                "PASS",
                "WARNING",
                "REPAIR_REQUIRED",
                "BLOCKING",
                "UNRESOLVED"
              ]
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "issueId": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_-]*$"
                  },
                  "issueClass": {
                    "type": "string",
                    "enum": [
                      "MISSING_LABEL",
                      "MISSING_VISUAL_FACT",
                      "UNSUPPORTED_VISUAL_FACT",
                      "TEXT_AS_VISUAL_LEAKAGE",
                      "SCALE_OVERCLAIM",
                      "PROVENANCE_ERROR",
                      "OTHER"
                    ]
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "affectedCandidateIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_-]*$"
                    }
                  }
                },
                "required": [
                  "issueId",
                  "issueClass",
                  "description",
                  "affectedCandidateIds"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "candidateLabel",
            "declaredMode",
            "expectedLabelCandidateIds",
            "labelCandidateIdsReviewed",
            "expectedObjectCandidateIds",
            "objectCandidateIdsReviewed",
            "expectedRelationCandidateIds",
            "relationCandidateIdsReviewed",
            "expectedInterpretationIds",
            "interpretationIdsReviewed",
            "missingCriticalVisualMeaning",
            "unsupportedVisualMeaningDetected",
            "textAsVisualLeakageDetected",
            "scaleOverclaimDetected",
            "decision",
            "issues"
          ],
          "additionalProperties": false
        }
      },
      "crossCandidateFindings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "findingId": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_-]*$"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "affectedCandidateLabels": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "CANDIDATE_A",
                  "CANDIDATE_B",
                  "CANDIDATE_C",
                  "CANDIDATE_D"
                ]
              }
            }
          },
          "required": [
            "findingId",
            "description",
            "affectedCandidateLabels"
          ],
          "additionalProperties": false
        }
      },
      "overallDecision": {
        "type": "string",
        "enum": [
          "PASS",
          "WARNING",
          "REPAIR_REQUIRED",
          "BLOCKING",
          "UNRESOLVED"
        ]
      }
    },
    "required": [
      "auditVersion",
      "auditId",
      "model",
      "effort",
      "independentOfOtherAudit",
      "mediaHash",
      "candidateAudits",
      "crossCandidateFindings",
      "overallDecision"
    ],
    "additionalProperties": false
  }
}
