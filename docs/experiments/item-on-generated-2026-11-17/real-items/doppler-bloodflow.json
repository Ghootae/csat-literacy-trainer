      "choices": [
        {
          "choice_id": "69bc1daba029f488d9e55066_q12_c1",
          "number": 1,
          "label": "①",
          "text": "ⓐ의 혈류 속도보다 ⓒ의 혈류 속도가 빠르다고 볼 수 있겠군.",
          "elements": [],
          "images": []
        },
        {
          "choice_id": "69bc1daba029f488d9e55066_q12_c2",
          "number": 2,
          "label": "②",
          "text": "ⓐ에서 ⓑ의 혈류 방향과 ⓑ에서 ⓒ의 혈류 방향은 동일하다고 볼 수 있겠군.",
          "elements": [],
          "images": []
        },
        {
          "choice_id": "69bc1daba029f488d9e55066_q12_c3",
          "number": 3,
          "label": "③",
          "text": "ⓑ보다 ⓒ가 송신 주파수와 수신 주파수의 차이가 크다고 볼 수 있겠군.",
          "elements": [],
          "images": []
        },
        {
          "choice_id": "69bc1daba029f488d9e55066_q12_c4",
          "number": 4,
          "label": "④",
          "text": "ⓒ와 ⓓ 사이에는 영상 장치의 화면에 혈류 정보가 빨간색으로 표시되겠군.",
          "elements": [],
          "images": []
        },
        {
          "choice_id": "69bc1daba029f488d9e55066_q12_c5",
          "number": 5,
          "label": "⑤",
          "text": "ⓓ보다 ⓒ에서 영상 장치의 화면에 혈류 정보의 색이 더 밝게 표시되겠군.",
          "elements": [],
          "images": []
        }
      ]
    },
    {
      "question_id": "69bc1daba029f488d9e55066_q13",
      "order": 4,
      "number": 13,
      "points": 2,
      "source_title": "어휘의 문맥적 의미 파악",
      "source_tags": [
        "어휘"
      ],
      "prompt_blocks": [
        {
          "type": "stem",
          "order": 1,
          "text": "㉮와 문맥상 의미가 가장 가까운 것은?",
          "elements": [],
          "images": []
        }
      ],
      "choices": [
        {
          "choice_id": "69bc1daba029f488d9e55066_q13_c1",
          "number": 1,
          "label": "①",
          "text": "금요일을 지나 토요일이 되었다.",
          "elements": [
            {
              "kind": "text_style",
              "start": 5,
              "end": 7,
              "underline": true,
              "text": "지나"
            }
          ],
          "images": []
        },
        {
          "choice_id": "69bc1daba029f488d9e55066_q13_c2",
          "number": 2,
          "label": "②",
          "text": "수험 생활도 지나고 나니 그립다.",
          "elements": [
            {
              "kind": "text_style",
              "start": 7,
              "end": 10,
              "underline": true,
              "text": "지나고"
            }
          ],
          "images": []
        },
        {
          "choice_id": "69bc1daba029f488d9e55066_q13_c3",
          "number": 3,
          "label": "③",
          "text": "바람이 창문 사이를 지나고 있다.",
          "elements": [
            {
              "kind": "text_style",
              "start": 11,
              "end": 14,
              "underline": true,
              "text": "지나고"
            }
          ],
          "images": []
        },
        {
          "choice_id": "69bc1daba029f488d9e55066_q13_c4",
          "number": 4,
          "label": "④",
          "text": "그는 그녀의 말을 무심결에 지나 버렸다.",
          "elements": [
            {
              "kind": "text_style",
              "start": 15,
              "end": 17,
              "underline": true,
              "text": "지나"
            }
          ],
          "images": []
        },
        {
          "choice_id": "69bc1daba029f488d9e55066_q13_c5",
          "number": 5,
          "label": "⑤",
          "text": "한 달 전에 산 우유의 소비 기한이 지났다.",
          "elements": [
            {
              "kind": "text_style",
              "start": 20,
              "end": 23,
              "underline": true,
              "text": "지났다"
            }
          ],
          "images": []
        }
      ]
    }
