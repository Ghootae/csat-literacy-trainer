      ],
      "choices": [
        {
          "choice_id": "69bc1daba029f488d9e55066_q11_c1",
          "number": 1,
          "label": "①",
          "text": "㉠에서 발생한 초음파가 ㉡에 입사될 때, 혈류의 방향과 이루는 각도를 60° 미만으로 유지해야 측정의 오차 값이 적겠군.",
          "elements": [],
          "images": []
        },
        {
          "choice_id": "69bc1daba029f488d9e55066_q11_c2",
          "number": 2,
          "label": "②",
          "text": "㉠에서 발생시킨 초음파의 강도는 ㉤에서 ㉣로 되돌아 나올 때보다 크겠군.",
          "elements": [],
          "images": []
        },
        {
          "choice_id": "69bc1daba029f488d9e55066_q11_c3",
          "number": 3,
          "label": "③",
          "text": "㉡에 젤을 바르기 전보다 후에 ㉢으로 더 많은 초음파가 투과되겠군.",
          "elements": [],
          "images": []
        },
        {
          "choice_id": "69bc1daba029f488d9e55066_q11_c4",
          "number": 4,
          "label": "④",
          "text": "㉢에서는 ㉠에서 발생한 초음파가 거의 일정한 속도로 투과하겠군.",
          "elements": [],
          "images": []
        },
        {
          "choice_id": "69bc1daba029f488d9e55066_q11_c5",
          "number": 5,
          "label": "⑤",
          "text": "㉣을 투과한 초음파의 주파수가 높을수록, ㉤의 크기가 클수록 더 많은 산란이 발생하겠군.",
          "elements": [],
          "images": []
        }
      ]
    },
    {
      "question_id": "69bc1daba029f488d9e55066_q12",
      "order": 3,
      "number": 12,
      "points": 3,
      "source_title": "도플러 효과 그래프 해석",
      "source_tags": [
        "시각-자료-해석",
        "추론"
      ],
      "prompt_blocks": [
        {
          "type": "stem",
          "order": 1,
          "text": "<보기>는 초음파 도플러 혈류계의 도플러 효과에 대해 설명하기 위한 그래프이다. 윗글을 읽은 학생이 <보기>에 대해 보인 반응으로 적절하지 않은 것은?",
          "elements": [],
          "images": []
        },
        {
