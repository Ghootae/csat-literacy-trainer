  "questions": [
    {
      "question_id": "69bc1daba029f488d9e55066_q10",
      "order": 1,
      "number": 10,
      "points": 2,
      "source_title": "글의 내용 일치 확인",
      "source_tags": [
        "내용-일치"
      ],
      "prompt_blocks": [
        {
          "type": "stem",
          "order": 1,
          "text": "윗글의 내용과 일치하지 않는 것은?",
          "elements": [],
          "images": []
        }
      ],
      "choices": [
        {
          "choice_id": "69bc1daba029f488d9e55066_q10_c1",
          "number": 1,
          "label": "①",
          "text": "초음파를 전달하는 매질의 밀도에 따라 음향 저항은 달라진다.",
          "elements": [],
          "images": []
        },
        {
          "choice_id": "69bc1daba029f488d9e55066_q10_c2",
          "number": 2,
          "label": "②",
          "text": "초음파 도플러 혈류계는 송신 주파수와 수신 주파수의 차이를 이용한다.",
          "elements": [],
          "images": []
        },
        {
          "choice_id": "69bc1daba029f488d9e55066_q10_c3",
          "number": 3,
          "label": "③",
          "text": "초음파 도플러 혈류계는 인간의 가청 범위 이상의 주파수를 가진 음파를 이용한다.",
          "elements": [],
          "images": []
        },
        {
          "choice_id": "69bc1daba029f488d9e55066_q10_c4",
          "number": 4,
          "label": "④",
          "text": "초음파 도플러 혈류계가 혈류 정보를 측정하여 영상화하는 과정은 송수신 단계와 표시 단계로 구분된다.",
          "elements": [],
          "images": []
        },
        {
          "choice_id": "69bc1daba029f488d9e55066_q10_c5",
          "number": 5,
          "label": "⑤",
          "text": "초음파 도플러 혈류계에서는 도플러 변위를 통해 얻은 혈류 속도와 방향에 대한 정보가 영상 장치에 저장된다.",
          "elements": [],
          "images": []
        }
      ]
    },
    {
      "question_id": "69bc1daba029f488d9e55066_q11",
      "order": 2,
      "number": 11,
      "points": 2,
      "source_title": "송수신 단계의 초음파 이동 경로 이해",
      "source_tags": [
        "시각-자료-해석"
      ],
      "prompt_blocks": [
        {
          "type": "stem",
          "order": 1,
          "text": "<보기>는 송수신 단계에서의 초음파 이동 경로를 도식화한 것이다. 윗글을 바탕으로 ㉠~㉤에 대해 이해한 내용으로 적절하지 않은 것은?",
          "elements": [
            {
              "kind": "phrase",
              "start": 6,
              "end": 12,
              "style": "box",
              "text": "송수신 단계"
            }
          ],
          "images": []
        },
        {
          "block_id": "69bc1daba029f488d9e55066_q11_supp01",
          "type": "supplement",
          "label": "보기",
          "order": 2,
          "text": "",
