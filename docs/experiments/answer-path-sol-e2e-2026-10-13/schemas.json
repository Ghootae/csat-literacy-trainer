{
  "map": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "questionId": {
        "type": "string"
      },
      "stemPolarity": {
        "type": "string",
        "enum": [
          "POSITIVE",
          "NEGATIVE"
        ]
      },
      "answerChoiceId": {
        "type": "string"
      },
      "choices": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "choiceId": {
              "type": "string"
            },
            "verdict": {
              "type": "string",
              "enum": [
                "APPROPRIATE",
                "INAPPROPRIATE"
              ]
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "READ",
                      "LINK",
                      "APPLY"
                    ]
                  },
                  "operation": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "string"
                  },
                  "dependsOn": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "layer": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "element": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "E1",
                          "E2",
                          "E3",
                          "E4",
                          "E5",
                          "E6",
                          "E7",
                          "E8",
                          "E9",
                          "E10"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "outsideVocabulary": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "type",
                  "operation",
                  "evidence",
                  "dependsOn",
                  "layer",
                  "element",
                  "outsideVocabulary"
                ],
                "additionalProperties": false
              }
            },
            "depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "coreElement": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "E1",
                    "E2",
                    "E3",
                    "E4",
                    "E5",
                    "E6",
                    "E7",
                    "E8",
                    "E9",
                    "E10"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "choiceId",
            "verdict",
            "nodes",
            "depth",
            "coreElement"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "questionId",
      "stemPolarity",
      "answerChoiceId",
      "choices"
    ],
    "additionalProperties": false
  },
  "run": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "caseId": {
        "type": "string"
      },
      "selectedChoiceId": {
        "type": "string"
      },
      "result": {
        "type": "string",
        "enum": [
          "CORRECT",
          "WRONG",
          "WRONG_NO_RATIONALE",
          "POLARITY_FAILURE"
        ]
      },
      "depth": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "GUESS_STATED",
            "RATIONALE_ERROR"
          ]
        }
      },
      "failedOperation": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "READ",
              "LINK",
              "APPLY",
              "UNDETERMINED"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "failedNodeId": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "failedElement": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "E1",
              "E2",
              "E3",
              "E4",
              "E5",
              "E6",
              "E7",
              "E8",
              "E9",
              "E10"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "nodeElement": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "E1",
              "E2",
              "E3",
              "E4",
              "E5",
              "E6",
              "E7",
              "E8",
              "E9",
              "E10"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "overrideQuote": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "candidates": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "nodeId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "READ",
                "LINK",
                "APPLY"
              ]
            },
            "element": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "E1",
                    "E2",
                    "E3",
                    "E4",
                    "E5",
                    "E6",
                    "E7",
                    "E8",
                    "E9",
                    "E10"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "nodeId",
            "type",
            "element",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "studentQuote": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "reason": {
        "type": "string"
      }
    },
    "required": [
      "caseId",
      "selectedChoiceId",
      "result",
      "depth",
      "tags",
      "failedOperation",
      "failedNodeId",
      "failedElement",
      "nodeElement",
      "overrideQuote",
      "candidates",
      "studentQuote",
      "reason"
    ],
    "additionalProperties": false
  }
}
