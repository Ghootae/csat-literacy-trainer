    "propositions": [
      {
        "id": "MP1",
        "paragraphId": "P1",
        "description": "선형 열팽창 계수는 온도 변화에 따른 길이 변화율을 온도 변화량으로 나눈 값이며, 대부분의 물질에서 양수이고 물질마다 값이 다르다.",
        "polarity": "positive",
        "conditions": [],
        "exceptions": [],
        "scope": "선형 열팽창 계수의 정의와 일반적 성질",
        "evidence": "\"선형 열팽창 계수인데, 이는 온도 변화에 따른 길이 변화율을 온도 변화량으로 나눈 값이다. ... 대부분의 물질은 선형 열팽창 계수가 양수이며 물질마다 그 값이 다르다.\"",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "MP2",
        "paragraphId": "P2",
        "description": "접합된 두 층 중 Q의 선형 열팽창 계수가 P보다 크면, 온도를 올렸을 때 띠는 P층 쪽으로 원호 형태로 휜다.",
        "polarity": "positive",
        "conditions": [
          "Q의 선형 열팽창 계수가 P보다 큼",
          "온도를 올림",
          "P층과 Q층이 접합되어 독립적 팽창이 억제됨"
        ],
        "exceptions": [],
        "scope": "서로 다른 열팽창 계수를 가진 접합 띠",
        "evidence": "\"Q가 P보다 선형 열팽창 계수가 크다면 온도를 올렸을 때 Q층은 P층보다 더 팽창하려고 한다. ... 띠가 P층 쪽으로 원의 호 형태로 휘면서 팽창한다.\"",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "MP3",
        "paragraphId": "P2",
        "description": "가열 후 처음 온도로 다시 내리면 접합 띠는 원래 모양으로 돌아온다.",
        "polarity": "positive",
        "conditions": [
          "가열된 접합 띠의 온도를 처음 온도로 다시 내림"
        ],
        "exceptions": [],
        "scope": "접합 띠의 온도 복귀",
        "evidence": "\"이후 다시 처음의 온도로 내리면 띠는 원래 모양으로 돌아온다.\"",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "MP4",
        "paragraphId": "P3",
        "description": "곡률은 곡률 반지름의 역수이므로, 곡률 반지름이 작을수록 띠는 더 심하게 휜다.",
        "polarity": "positive",
        "conditions": [],
        "exceptions": [],
        "scope": "띠의 곡률과 곡률 반지름의 관계",
        "evidence": "\"곡률은 이 곡률 반지름의 역수이다. 즉, 곡률 반지름이 작을수록 더 심하게 휘어진 것이다.\"",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "MP5",
        "paragraphId": "P3",
        "description": "다른 조건이 동일하면 두 물질의 선형 열팽창 계수 차이가 크거나 온도 변화가 클수록 띠는 더 심하게 휜다.",
        "polarity": "positive",
        "conditions": [
          "그 밖의 조건이 동일함"
        ],
        "exceptions": [],
        "scope": "접합 띠의 휨 정도",
        "evidence": "\"다른 조건이 동일하다면, 두 물질의 선형 열팽창 계수 차이가 크거나 온도 변화가 클수록 띠가 더 휘어진다.\"",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "MP6",
        "paragraphId": "P3",
        "description": "휨 민감도가 더 크다는 것은 같은 온도 변화량에서 띠가 더 심하게 휜다는 뜻이다.",
        "polarity": "positive",
        "conditions": [
          "온도 변화량이 같음"
        ],
        "exceptions": [],
        "scope": "휨 민감도의 의미",
        "evidence": "\"휨 민감도가 더 크다는 것은 같은 온도 변화량에서 띠가 더 심하게 휨을 의미한다.\"",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "MP7",
        "paragraphId": "P4",
        "description": "띠의 한쪽 끝을 고정하고 열을 가하면, 띠가 휘면서 반대쪽 끝이 움직이는 액추에이터가 된다.",
        "polarity": "positive",
        "conditions": [
          "띠의 한쪽 끝을 고정함",
          "열을 가함"
        ],
        "exceptions": [],
        "scope": "띠 액추에이터",
        "evidence": "\"띠의 한쪽 끝을 고정하고 열을 가하면 띠가 휘면서 반대쪽 끝이 움직이는 액추에이터가 된다.\"",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "MP8",
        "paragraphId": "P5",
        "description": "띠가 더 많이 휠수록 고정되지 않은 끝의 이동 거리는 더 커진다.",
        "polarity": "positive",
        "conditions": [],
        "exceptions": [],
        "scope": "띠의 휨과 끝 이동 거리",
        "evidence": "\"띠가 휠수록 고정되지 않은 끝의 이동 거리는 커진다.\"",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "MP9",
        "paragraphId": "P5",
        "description": "최대 이동 거리는 외부의 휨 방해 힘이 없다고 할 때 주어진 온도 변화량에서 띠 끝이 최대로 이동할 수 있는 거리이며, 띠의 길이에 따라 달라진다.",
        "polarity": "positive",
        "conditions": [
          "휨을 방해하는 외부의 힘이 없음"
        ],
        "exceptions": [],
        "scope": "최대 이동 거리",
        "evidence": "\"최대 이동 거리는 휨을 방해하는 외부의 힘이 없다고 가정할 때, 주어진 온도 변화량에서 띠의 끝이 최대로 이동할 수 있는 거리이다. 이 값은 띠의 길이에 따라 달라진다.\"",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "MP10",
        "paragraphId": "P5",
        "description": "띠 끝이 외부에 가할 수 있는 힘은 끝이 최대 이동 거리에 도달하여 휨이 완료되었을 때 소멸하며, 이 시점은 띠가 최대 곡률에 도달한 시점과 같다.",
        "polarity": "positive",
        "conditions": [],
        "exceptions": [],
        "scope": "외력의 소멸 시점과 최대 곡률",
        "evidence": "\"이 힘은 띠의 끝이 최대 이동 거리에 도달하여 휨이 완료되었을 때 소멸된다. 따라서 ... 이는 띠가 휘는 과정에서 최대의 곡률에 도달했을 때와 같다.\"",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "MP11",
        "paragraphId": "P5",
        "description": "반응 완료 시간은 가열을 시작한 때부터 띠 끝이 최대 이동 거리에 도달할 때까지의 시간이며, 띠의 두께가 얇을수록 짧다.",
        "polarity": "positive",
        "conditions": [],
        "exceptions": [],
        "scope": "반응 완료 시간",
        "evidence": "\"반응 완료 시간은 온도를 올리기 시작한 시점부터 띠의 끝이 최대 이동 거리에 도달하기까지의 시간이고, 띠의 두께가 얇을수록 짧다.\"",
        "basis": "PASSAGE_EXPLICIT"
      }
    ]
  },
