          "text": "{\n  \"stem\": \"문맥상 ⓐ～ⓔ와 바꿔 쓰기에 적절하지 않은 것은?\",\n  \"form\": \"B\",\n  \"answer\": 3,\n  \"targets\": [\n    {\n      \"mark\": \"ⓐ\",\n      \"text\": \"인력으로 발생하는 표면 장력\",\n      \"word\": \"발생하는\",\n      \"sense\": \"어떤 현상이 생겨나는.\"\n    },\n    {\n      \"mark\": \"ⓑ\",\n      \"text\": \"지질과 단백질로 구성된 계면 활성제\",\n      \"word\": \"구성된\",\n      \"sense\": \"여러 성분이 모여 하나의 전체를 이룬.\"\n    },\n    {\n      \"mark\": \"ⓒ\",\n      \"text\": \"두 기포가 접하여 하나로 합쳐질 때\",\n      \"word\": \"접하여\",\n      \"sense\": \"두 물체가 서로 맞닿아.\"\n    },\n    {\n      \"mark\": \"ⓓ\",\n      \"text\": \"이 잉크 방울은 종이에 도달한다\",\n      \"word\": \"도달한다\",\n      \"sense\": \"이동하여 어떤 곳에 다다른다.\"\n    },\n    {\n      \"mark\": \"ⓔ\",\n      \"text\": \"구형의 잉크 방울이 형성되는 것만으로\",\n      \"word\": \"형성되는\",\n      \"sense\": \"어떤 모양을 갖추어 이루어지는.\"\n    }\n  ],\n  \"choices\": [\n    {\n      \"n\": 1,\n      \"text\": \"ⓐ: 생기는\",\n      \"truth\": \"맞음\",\n      \"sense\": \"없던 현상이 새로 나타나는.\",\n      \"why\": \"인력으로 인해 표면 장력이 생겨난다는 뜻이 그대로 유지된다.\"\n    },\n    {\n      \"n\": 2,\n      \"text\": \"ⓑ: 이루어진\",\n      \"truth\": \"맞음\",\n      \"sense\": \"여러 성분이 모여 하나의 전체가 된.\",\n      \"why\": \"지질과 단백질이 계면 활성제의 성분을 이룬다는 뜻이 그대로 유지된다.\"\n    },\n    {\n      \"n\": 3,\n      \"text\": \"ⓒ: 마주하여\",\n      \"truth\": \"틀림\",\n      \"sense\": \"서로 똑바로 향하여 대하여.\",\n      \"why\": \"두 물체가 서로 대하는 상황을 나타낼 수는 있지만, 두 기포의 표면이 맞닿는다는 뜻은 나타내지 못한다.\"\n    },\n    {\n      \"n\": 4,\n      \"text\": \"ⓓ: 닿는다\",\n      \"truth\": \"맞음\",\n      \"sense\": \"움직여 어떤 곳에 이른다.\",\n      \"why\": \"잉크 방울이 이동하여 종이에 이른다는 뜻이 그대로 유지된다.\"\n    },\n    {\n      \"n\": 5,\n      \"text\": \"ⓔ: 만들어지는\",\n      \"truth\": \"맞음\",\n      \"sense\": \"어떤 모양이나 상태를 갖춘 것이 생겨나는.\",\n      \"why\": \"잉크가 구형의 방울을 이룬다는 뜻이 그대로 유지된다.\"\n    }\n  ]\n}",
