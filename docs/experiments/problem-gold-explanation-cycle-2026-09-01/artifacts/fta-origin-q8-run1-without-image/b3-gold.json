    "propositions": [
      {
        "id": "P1",
        "paragraphId": "para1",
        "description": "자유 무역 협정에서 역내국들은 관세를 비롯한 무역 장벽을 완화하거나 철폐하여 상호 간 무역 특혜를 부여한다.",
        "polarity": "positive",
        "conditions": [],
        "exceptions": [],
        "scope": "자유 무역 협정의 역내국",
        "evidence": "이를 위해 역내국들은 관세를 비롯한 무역 장벽을 완화하거나 철폐하여 상호 간에 무역 특혜를 부여한다.",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "P2",
        "paragraphId": "para3",
        "description": "무역 전환 효과가 발생하면 역내국의 관세 수입이 줄어 경제적 후생이 감소될 수 있다.",
        "polarity": "positive",
        "conditions": [
          "기존 수입품이 자유 무역 협정 체결 후 역내국 상품으로 대체되는 경우"
        ],
        "exceptions": [],
        "scope": "무역 전환 효과",
        "evidence": "이때 역내국의 관세 수입이 줄어 경제적 후생이 감소될 수 있으므로",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "P3",
        "paragraphId": "para4",
        "description": "무역 굴절 효과는 역외국이 역내국 간 무역 특혜를 이용하여 자기에게 유리한 방향으로 상품을 역내국에 우회 수출하는 현상이다.",
        "polarity": "positive",
        "conditions": [],
        "exceptions": [],
        "scope": "무역 굴절 효과",
        "evidence": "마지막으로 무역 굴절 효과는 역내국 간의 무역 특혜를 이용하여 역외국이 자국에 유리한 방향으로 상품을 역내국에 우회 수출하는 현상이다.",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "P4",
        "paragraphId": "para4",
        "description": "역내국들이 역외국에 서로 다른 관세를 부과하도록 허용되는 자유 무역 협정에서는, 역외국이 자신에게 높은 관세를 부과하는 역내국에 수출할 상품을 자신에게 낮은 관세를 부과하는 역내국을 거쳐 수출하여 이전보다 더 많은 이익을 얻을 수 있다.",
        "polarity": "positive",
        "conditions": [
          "역내국들이 역외국에 서로 다른 관세를 부과하는 경우"
        ],
        "exceptions": [],
        "scope": "무역 굴절 효과의 발생 방식",
        "evidence": "역외국이 자국에 높은 관세를 부과하는 역내국에 바로 수출하던 상품을, 자국에 낮은 관세를 부과하는 역내국을 거쳐 수출함으로써 이전보다 더 많은 이익을 얻는 것이다.",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "P5",
        "paragraphId": "para5",
        "description": "역내국은 수입 상품의 원산지를 판정하여 원산지가 역내인 경우에만 관세 혜택을 부여한다.",
        "polarity": "positive",
        "conditions": [],
        "exceptions": [],
        "scope": "자유 무역 협정의 원산지 판정",
        "evidence": "역내국은 이 기준에 따라 수입 상품의 원산지를 판정해서 원산지가 역내인 경우에만 관세 혜택을 부여한다.",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "P6",
        "paragraphId": "para6",
        "description": "역내 가공 원칙과 충분 가공 원칙 등의 원산지 결정 기준 기본 원칙을 충족하지 못한 상품은 역내 원산지 상품으로 인정받지 못한다.",
        "polarity": "positive",
        "conditions": [
          "원산지 결정 기준의 기본 원칙을 충족하지 못한 경우"
        ],
        "exceptions": [],
        "scope": "원산지 결정 기준의 기본 원칙",
        "evidence": "이를 충족하지 못하면 역내 원산지 상품으로 인정받지 못한다.",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "P7",
        "paragraphId": "para7",
        "description": "상품 가공 공정의 일부가 역외에서 이루어진 경우, 역내 가공 원칙상 그 상품은 원칙적으로 역내 원산지 상품으로 인정받을 수 없다.",
        "polarity": "negative",
        "conditions": [
          "상품 가공 공정의 일부가 역외에서 이루어진 경우"
        ],
