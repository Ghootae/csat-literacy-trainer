        "exceptions": [],
        "scope": "완전 생산 기준",
        "evidence": "이를 충족하면 역내 원산지 상품으로 인정받는다.",
        "basis": "PASSAGE_EXPLICIT"
      },
      {
        "id": "P10",
        "paragraphId": "para8",
        "description": "역외 생산 재료를 사용하여 가공한 상품은 실질 변형 기준을 적용하여 원산지를 판정해야 한다.",
        "polarity": "positive",
        "conditions": [
