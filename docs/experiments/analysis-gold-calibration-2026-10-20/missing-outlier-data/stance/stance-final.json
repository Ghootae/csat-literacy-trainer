  "stances": [
    {
      "id": "P1-1",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "데이터를 처리할 때 데이터의 정확성은 매우 중요하다.",
      "note": ""
    },
    {
      "id": "P1-2",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "그런데 데이터에 결측치와 이상치가 포함되면 데이터의 특징을 제대로 나타내기 어렵다.",
      "note": ""
    },
    {
      "id": "P2-1",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "결측치는 데이터 값이 빠져 있는 것이다.",
      "note": ""
    },
    {
      "id": "P2-2",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "결측치를 처리하는 방법 중 하나인 대체는 다른 값으로 결측치를 채우는 것인데,",
      "note": ""
    },
    {
      "id": "P2-3",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "대체하는 값으로는 평균, 중앙값, 최빈값을 많이 사용한다.",
      "note": ""
    },
    {
      "id": "P2-4",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "중앙값은 데이터를 크기순으로 정렬했을 때 중앙에 위치한 값이다.",
      "note": ""
    },
    {
      "id": "P2-5",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "크기가 같은 값이 복수일 경우에도 순위를 매겨 중앙값을 찾고,",
      "note": ""
    },
    {
      "id": "P2-6",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "데이터의 개수가 짝수이면 중앙에 있는 두 값의 평균이 중앙값이다.",
      "note": ""
    },
    {
      "id": "P2-7",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "또 최빈값은 데이터에 가장 많이 나타나는 값을 이른다.",
      "note": ""
    },
    {
      "id": "P2-8",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "일반적으로 데이터 값이 연속적인 수치이면 평균으로, 석차처럼 순위가 있는 값에는 중앙값으로, 직업과 같이 문자인 경우에는 최빈값으로 결측치를 대체한다.",
      "note": ""
    },
    {
      "id": "P2-9",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "일반적으로 데이터 값이 연속적인 수치이면 평균으로, 석차처럼 순위가 있는 값에는 중앙값으로, 직업과 같이 문자인 경우에는 최빈값으로 결측치를 대체한다.",
      "note": ""
    },
    {
      "id": "P2-10",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "일반적으로 데이터 값이 연속적인 수치이면 평균으로, 석차처럼 순위가 있는 값에는 중앙값으로, 직업과 같이 문자인 경우에는 최빈값으로 결측치를 대체한다.",
      "note": ""
    },
    {
      "id": "P3-1",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "이상치는 데이터의 다른 값에 비해 유달리 크거나 작은 값으로,",
      "note": ""
    },
    {
      "id": "P3-2",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "데이터를 수집할 때 측정 오류 등에 의해 주로 생긴다.",
      "note": ""
    },
    {
      "id": "P3-3",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "그러나 정상적인 데이터라도 데이터의 특징을 왜곡하는 데이터 값이 있을 수 있다.",
      "note": ""
    },
    {
      "id": "P3-4",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "예를 들어, 데이터가 어떤 프로 선수들의 연봉이고 그중 한 명의 연봉이 유달리 많다면, 이상치가 포함된 데이터에 해당한다.",
      "note": ""
    },
    {
      "id": "P3-5",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "이런 데이터의 특징을 하나의 수치로 나타내려는 경우 대푯값으로 평균보다 중앙값을 주로 사용한다.",
      "note": ""
    },
    {
      "id": "P4-1",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "평면상에 있는 점들의 위치를 나타내는 데이터에서도 이상치를 발견할 수 있다.",
      "note": ""
    },
    {
      "id": "P4-2",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "대부분의 점들이 가상의 직선 주위에 모여 있다면 이 직선은 데이터의 특징을 잘 나타낸다고 할 수 있다.",
      "note": ""
    },
    {
      "id": "P4-3",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "이 직선을 직선 L이라고 하자.",
      "note": ""
    },
    {
      "id": "P4-4",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "그런데 직선 L로부터 멀리 떨어진 위치에도 몇 개의 점이 있다.",
      "note": ""
    },
    {
      "id": "P4-5",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "이 점들이 이상치이다.",
      "note": ""
    },
    {
      "id": "P5-1",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "이상치를 포함하는 데이터에서 직선 L을 찾는다고 하자.",
      "note": ""
    },
    {
      "id": "P5-2",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "이때 사용할 수 있는 기법의 하나인 A 기법은 두 점을 무작위로 골라",
      "note": ""
    },
    {
      "id": "P5-3",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "두 점을 무작위로 골라 정상치 집합으로 가정하고,",
      "note": ""
    },
    {
      "id": "P5-4",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "이 두 점을 지나는 후보 직선을 그어",
      "note": ""
    },
    {
      "id": "P5-5",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "나머지 점들과 후보 직선 사이의 거리를 구한다.",
      "note": ""
    },
    {
      "id": "P5-6",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "이 거리가 허용 범위 이내인 점들을 정상치 집합에 추가한다.",
      "note": ""
    },
    {
      "id": "P5-7",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "정상치 집합의 점의 개수가 미리 정해 둔 기준, 즉 문턱값보다 많으면 후보 직선을 최종 후보군에 넣는다.",
      "note": ""
    },
    {
      "id": "P5-8",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "반대로 점의 개수가 문턱값보다 적으면 후보 직선을 버린다.",
      "note": ""
    },
    {
      "id": "P5-9",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "만약 처음에 고른 점이 이상치이면, 대부분의 점들은 해당 후보 직선과의 거리가 너무 멀어",
      "note": ""
    },
    {
      "id": "P5-10",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "만약 처음에 고른 점이 이상치이면, 대부분의 점들은 해당 후보 직선과의 거리가 너무 멀어 이 직선은 최종 후보군에서 제외되는 것이다.",
      "note": ""
    },
    {
      "id": "P5-11",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "이 과정을 반복하여 최종 후보군을 구하고,",
      "note": ""
    },
    {
      "id": "P5-12",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "최종 후보군에 포함된 직선 중에서 정상치 집합의 데이터 개수가 최대인 직선을 직선 L로 선택한다.",
      "note": ""
    },
    {
      "id": "P5-13",
      "kind": "AUTHOR",
      "holder": null,
      "evidence": "이 기법은 이상치가 있어도 직선 L을 찾을 가능성이 높다.",
      "note": ""
    }
