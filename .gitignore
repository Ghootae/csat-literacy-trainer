# 의존성·빌드 산출물
node_modules/
dist/
*.tsbuildinfo

# 비밀·환경
.env
.env.*

# macOS
.DS_Store

# 폐기된 구 데이터셋 (suneung_db로 대체)
data/

# LLM 계측 (무한 증가, 재생성 가능)
.omc/metrics/

# 로컬 모델 파일럿 원시 실행물 (요약·승인 fixture만 docs/와 packages/에 커밋)
.omc/experiments/

# OMC 프로젝트 메모리 (런타임 상태)
.omc/project-memory.json

# OMC 런타임 상태 (세션 스코프)
.omc/state/
.omc/logs/
.omc/sessions/

# 골드 생성 중간 단계 캐시 (재생성 가능, 최종 산출물만 커밋)
.omc/agreement/*.steps/

# adhoc CLI 작업 공간 (임시 입력·평가 캐시). 남길 것은 content/ 와 docs/experiments/ 에 있다.
# `sessions/.eval-cache`·`.omc/state/assess-cache`와 같은 성격인데 여기만 추적되고 있었다.
.omc/adhoc/

# 유지: .omc/plans, .omc/specs (설계 문서), .omc/agreement/*.json (측정 결과)

# 잔재: 중첩 .omc 런타임 상태
**/.omc/state/
**/.omc/logs/
**/.omc/sessions/

# 학생 세션 기록 (개인 데이터, 무한 증가)
sessions/

# 실험 중 내려받은 PDF·렌더 이미지 등 재생성 가능한 임시 자료
tmp/
