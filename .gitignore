# 의존성·빌드 산출물
node_modules/
dist/
*.tsbuildinfo

# 비밀·환경
.env
.env.*

# macOS
.DS_Store

# 폐기된 구 데이터셋 (suneung_db로 대체)
data/

# LLM 계측 (무한 증가, 재생성 가능)
.omc/metrics/

# OMC 프로젝트 메모리 (런타임 상태)
.omc/project-memory.json

# OMC 런타임 상태 (세션 스코프)
.omc/state/
.omc/logs/
.omc/sessions/

# 골드 생성 중간 단계 캐시 (재생성 가능, 최종 산출물만 커밋)
.omc/agreement/*.steps/

# 유지: .omc/plans, .omc/specs (설계 문서), .omc/agreement/*.json (측정 결과)

# 잔재: 중첩 .omc 런타임 상태
**/.omc/state/
**/.omc/logs/
**/.omc/sessions/
